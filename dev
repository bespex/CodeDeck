#!/usr/bin/env bash
# Start the current state of CodeDeck from source.
#
#   ./dev [DIR]        open DIR (default: the directory you are in) with hot reload
#   ./dev --link       make this script available everywhere as `codedeck-dev`
#
# Frontend changes appear immediately; Rust changes rebuild and restart the window.

set -euo pipefail

repo="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

case "${1:-}" in
  -h | --help)
    sed -n '2,7s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  --link)
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$repo/dev" "$HOME/.local/bin/codedeck-dev"
    echo "Linked: $HOME/.local/bin/codedeck-dev -> $repo/dev"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "Note: $HOME/.local/bin is not in your PATH." ;; esac
    exit 0
    ;;
esac

project="$(readlink -f "${1:-$PWD}")"
if [[ ! -d "$project" ]]; then
  echo "dev: $project is not a directory" >&2
  exit 2
fi

cd "$repo"

for tool in npm cargo; do
  command -v "$tool" >/dev/null || { echo "dev: $tool not found" >&2; exit 1; }
done

# Install or refresh dependencies only when package-lock.json is newer than the last install
if [[ ! -d node_modules || package-lock.json -nt node_modules/.package-lock.json ]]; then
  npm install --no-audit --no-fund
fi

# The dev server needs its fixed port; a second instance would fail with an unclear error
if (exec 3<>/dev/tcp/127.0.0.1/1420) 2>/dev/null; then
  echo "dev: port 1420 is in use - is another ./dev still running?" >&2
  exit 1
fi

echo "CodeDeck (dev) -> $project"
# First `--` ends the tauri options, second `--` ends the cargo options; the rest goes to codedeck
exec npx tauri dev -- -- "$project"
