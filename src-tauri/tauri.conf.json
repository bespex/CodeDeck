{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeDeck",
  "mainBinaryName": "codeck",
  "version": "0.1.1",
  "identifier": "net.spex.codedeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeDeck",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "Bert Speckels <skrrytch@speckels.net>",
    "license": "MIT",
    "homepage": "https://github.com/bespex/CodeDeck",
    "category": "Development",
    "shortDescription": "AI session radar for Linux – be spex",
    "longDescription": "CodeDeck runs beside your AI coding sessions: it shows what each session is doing and what it changed, keeps a snapshot before every turn to go back to, and attaches exactly what you choose to your next prompt. It is not an editor: files open in small external viewers. The command is codeck.",
    "linux": {
      "deb": {
        "desktopTemplate": "codedeck.desktop"
      }
    },
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
