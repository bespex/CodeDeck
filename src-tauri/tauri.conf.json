{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeDeck",
  "mainBinaryName": "codedeck",
  "version": "0.4.6",
  "identifier": "net.spex.codedeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "Bert Speckels <skrrytch@speckels.net>",
    "license": "MIT",
    "homepage": "https://github.com/bespex/CodeDeck",
    "category": "Development",
    "shortDescription": "AI session radar for Linux – be spex",
    "longDescription": "CodeDeck runs beside your AI coding sessions: it shows what each session is\ndoing or asking, and what it changed, file by file and turn by turn.\n\nBefore every turn it keeps a snapshot to go back to, and it attaches exactly\nwhat you choose to your next prompt: files, changes, line comments and @ai\nhints. It is not an editor: files open in small viewers such as Marq and Dirq.\n\nPart of be spex – apps for the way you work: https://bespex.github.io",
    "linux": {
      "deb": {
        "desktopTemplate": "codedeck.desktop"
      }
    },
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/24x24.png",
      "icons/16x16.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5N0MxRTlFMjlGN0FCNkQKUldSdHEvY3BuaDU4dVJ4WVlqTll2b25sMmdhUlVjNXJhZDFZMEZNU3RxeVlqdXRZWlJyeGdsbUoK",
      "endpoints": [
        "https://github.com/bespex/CodeDeck/releases/latest/download/latest.json"
      ]
    }
  }
}
